    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "brace-expansion": "^2.0.1",
    "glob": "^11.0.0",
    "source-map-js": "^1.2.2",
    "micromatch": "^4.0.8",
    "fast-glob": "^3.3.3",
    "@next/eslint-plugin-next": {
      "glob": "^11.0.0"
