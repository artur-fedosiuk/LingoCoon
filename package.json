{
  "name": "lingocoon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/test-setup.mjs --test tests/*.test.mjs",
    "check": "npm run security:secrets && npm run test:security && npm run lint && npm run typecheck && npm run build",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:secrets:history": "node scripts/check-secrets.mjs --history",
    "security:secrets:self-test": "node scripts/check-secrets.mjs --self-test"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "i18next": "^26.5.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@rushstack/eslint-patch": "^1.16.1",
    "braces": "^3.0.3",
    "brace-expansion": "^2.0.1",
    "glob": "^11.0.0",
    "source-map-js": "^1.2.2",
    "micromatch": "^4.0.8",
    "fast-glob": "^3.3.3"
  }
