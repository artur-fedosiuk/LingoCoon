# =============================================================================
# Supabase Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api
# =============================================================================

# Your Supabase project URL
# Found at: Project Settings > API > Project URL
# Format: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anonymous/public key
# Found at: Project Settings > API > Project API keys > anon/public
# This key is safe to use in browser code
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this application.
# Use http://localhost:3000 during local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Optional: Additional Supabase Configuration
# =============================================================================

# Your Supabase service role key (KEEP SECRET - server-side only!)
# Found at: Project Settings > API > Project API keys > service_role
# WARNING: Never expose this in client-side code or commit to version control
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Google Cloud Chirp 3 HD — all product speech
# =============================================================================
READING_ENABLED=false
NEXT_PUBLIC_READING_ENABLED=false
READING_TTS_PROVIDER=google
GOOGLE_TTS_ENABLED=false
# Server-only key restricted to Cloud Text-to-Speech.
GOOGLE_TTS_API_KEY=
# At least 32 random characters. Never expose either secret in browser code.
READING_TTS_CACHE_SECRET=
# SUPABASE_SERVICE_ROLE_KEY is required in every environment, including local.
# Apply the TTS migrations and reconcile a Chirp budget period before activation.
# Maximum 999,700 characters, less previous/external Chirp usage.
# Missing configuration or budget denies generation. No direct/local bypass.
# Google bills excess usage; the app cannot control other clients using the account.
CRON_SECRET=

# =============================================================================
# Google Gemini AI (required)
# =============================================================================
#
# Create a Google Gemini API key:
# https://aistudio.google.com/app/apikey
#
# The app uses two Gemini model slots:
#   1. Chat model    — for free-form conversation (study sessions, general chat)
#   2. Structured model — for JSON responses (dictionary, deck generation, translation)
#
# Both default to gemini-3.5-flash-lite (fast, free, stable JSON output).
# Keep this key server-side only. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL_ID=gemini-3.5-flash-lite
# GEMINI_STRUCTURED_MODEL_ID=gemini-3.5-flash-lite

# =============================================================================
# Optional: Speech-to-Text (microphone)
# =============================================================================
#
# Speech input requires a Whisper-compatible transcription endpoint.
# If STT_API_KEY is empty, the microphone feature is disabled.
# Configure STT_ENDPOINT to point to any Whisper-compatible service.
STT_API_KEY=
# STT_ENDPOINT=https://your-stt-endpoint/v1/audio/transcriptions
# STT_MODEL_ID=whisper-1
