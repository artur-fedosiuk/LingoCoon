{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "MultiEdit",
      "Bash",
      "npm run lint",
      "npm run typecheck",
      "npm run test:security",
      "npm run check",
      "npm run security:secrets",
      "npm run security:secrets:history",
      "npm run security:secrets:self-test",
      "npm run build",
      "npm run dev",
      "npm ci",
      "git status",
      "git diff",
      "git log",
      "git diff --check"
    ],
    "ask": [],
    "deny": [
      "git push*",
      "rm -rf*",
      "sudo*",
      "curl*",
      "wget*",
      "Read .env*",
      "Read .claude/*.bak*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-env.mjs \"${TOOL_INPUT}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-edited.mjs \"${TOOL_INPUT}\""
          }
        ]
      }
    ]
  }
}